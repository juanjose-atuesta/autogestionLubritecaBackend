# Variables de entorno de ejemplo. Copia este archivo a .env y completa los valores.
# NO subas credenciales reales al repositorio.

# URI de conexión a MongoDB Atlas (incluye usuario y contraseña).
# Ejemplo: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# El backend agrega automáticamente el nombre de la base de datos (autogestionLubritecaDB)
# si la URI no lo incluye.
MONGODB_URI=

# Credenciales por separado (opcionales, solo referencia; el código usa MONGODB_URI).
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Puerto del servidor (Render lo define automáticamente; en local por defecto 3000).
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=production

# Token requerido en la cabecera X-Admin-Token para las rutas de export/import a Excel.
ADMIN_EXPORT_IMPORT_TOKEN=

# Permitir rutas de admin desde local en desarrollo (true | false).
ALLOW_LOCAL_ADMIN=false
